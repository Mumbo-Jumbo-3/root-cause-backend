{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "root-cause-backend",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Backend",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      // Keep the container next to the Neon region (AWS us-east): RAG makes several queries per question.
      "constraints": { "regions": ["ENAM"] }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
  },
  "exports": {
    "Backend": { "type": "durable-object", "storage": "sqlite" }
  },
  // Secrets (wrangler secret put): ANTHROPIC_API_KEY, XAI_API_KEY, VOYAGE_API_KEY, DATABASE_URL,
  // CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY, BACKEND_WEBHOOK_SECRET, LANGSMITH_API_KEY
  "vars": {
    "LANGSMITH_TRACING": "true",
    "LANGSMITH_PROJECT": "health-agent",
    "LANGSMITH_ENDPOINT": "https://api.smith.langchain.com"
  }
}
